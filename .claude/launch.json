{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lyrics-game-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "lyrics-game",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "lyrics-game-web",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:APP_MODE='web'; $env:AUTH_SECRET='local-test-secret-at-least-32-characters-long'; $env:GOOGLE_CLIENT_ID='test-client'; $env:GOOGLE_CLIENT_SECRET='test-secret'; npm --prefix lyrics-game run dev -- -p 3100"
      ],
      "port": 3100
    }
  ]
}