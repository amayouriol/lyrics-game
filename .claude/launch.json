{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lyrics-game-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "lyrics-game",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "lyrics-game-web",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-Command",
        "$env:APP_MODE='web'; $env:WEB_GATE_WORD='testword'; npm --prefix lyrics-game run dev -- -p 3100"
      ],
      "port": 3100
    }
  ]
}