# Copy this file to .env.local and fill in the values from
# https://developer.spotify.com/dashboard (create an app there first).
#
# In the app's settings, add this exact Redirect URI:
#   http://127.0.0.1:3000/api/auth/callback

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# For finding YouTube videos (free): console.cloud.google.com → new project →
# enable "YouTube Data API v3" → create an API key, limited to that API.
# Google asks for 2-step verification on the account first.
YOUTUBE_API_KEY=

# Encrypts the session cookie. Any random string 32+ characters long.
# A fresh one has already been generated for you in .env.local.
SESSION_SECRET=

# Only for the web version (a hosted copy for friends, YouTube only). Leave
# these out on your own computer.
# APP_MODE=web
# The shared word friends type once per browser. Without it nothing opens.
# WEB_GATE_WORD=
# The free database (upstash.com, a Redis database, "REST API" section).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Sign in with Google (web version). A "Web" OAuth client from Google Cloud
# (APIs & Services > Credentials). Redirect address to add there:
#   https://<your-address>/api/auth/google/callback
# (and http://localhost:3000/api/auth/google/callback for trying it here).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Any long random text (32+ characters); it signs the "who is signed in" cookie.
# Changing it signs everyone out. Make one with: openssl rand -base64 32
# AUTH_SECRET=
